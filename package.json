    "type": "git",
    "url": "git+https://github.com/nuasense/node-red-contrib-nuasense.git"
  },
  "bugs": {
    "url": "https://github.com/nuasense/node-red-contrib-nuasense/issues"
  },
  "keywords": [
    "node-red",
    "nuasense",
    "weather-station",
    "weather",
    "agriculture",
    "ecowitt",
    "farm",
    "spray-window",
    "evapotranspiration"
  ],
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "nuasense-station": "nodes/station.js",
      "nuasense-intelligence": "nodes/intelligence.js"
    }
  },
  "files": [
    "nodes",
    "lib",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
